From ef5c090af5158e61fe10acf96747e4d35be0c330 Mon Sep 17 00:00:00 2001
From: openhands <openhands@all-hands.dev>
Date: Thu, 29 Oct 2026 03:53:18 +0000
Subject: [PATCH 3/3] Instalar Ollama de forma determinista en el runner

El install.sh oficial usa curl|sh y aborta si falta zstd (que no siempre
esta en ubuntu-latest). Ahora fijamos la version, verificamos el sha256
oficial y extraemos con zstd.

Verificado en el sandbox: el bloque entero corre tal cual, hash OK,
extraccion OK, binario arranca.
---
 .github/workflows/bot-vibe.yml | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/bot-vibe.yml b/.github/workflows/bot-vibe.yml
index 78cb147..7d4a074 100644
--- a/.github/workflows/bot-vibe.yml
+++ b/.github/workflows/bot-vibe.yml
@@ -41,8 +41,22 @@ jobs:
 
       - name: Instalar y levantar Ollama
         run: |
+          # Instalacion determinista en vez del install.sh oficial: ese usa
+          # curl|sh y aborta si falta zstd. Aca fijamos version y verificamos
+          # el sha256 oficial, asi el runner no se rompe si cambia el ultimo
+          # release a mitad de camino.
+          OLLAMA_VER="v0.40.13"
+          OLLAMA_SHA="c9490e0f520be21271d969e6703f012268b1d39f8b70dd58854e5bfef7a75bb6"
           if ! command -v ollama >/dev/null; then
-            curl -fsSL https://ollama.com/install.sh | sh
+            if ! command -v zstd >/dev/null; then
+              sudo apt-get update -q && sudo apt-get install -y -q zstd
+            fi
+            curl -fsSL -o /tmp/ollama.tar.zst \
+              "https://github.com/ollama/ollama/releases/download/${OLLAMA_VER}/ollama-linux-amd64.tar.zst"
+            echo "${OLLAMA_SHA}  /tmp/ollama.tar.zst" | sha256sum -c -
+            # tar solo no descomprime .zst: hace falta pasarlo por zstd.
+            zstd -d -c /tmp/ollama.tar.zst | sudo tar -xf - -C /usr/local
+            rm -f /tmp/ollama.tar.zst
           fi
           ollama serve &
           for i in $(seq 1 30); do
