# Cell 2: Entrenamiento
import os
from unsloth import FastLanguageModel
from datasets import load_dataset
from trl import SFTTrainer
from transformers import TrainingArguments

HF_TOKEN = os.environ.get("HF_TOKEN")
HF_DATASET_REPO = os.environ.get("HF_REPO")
HF_MODEL_OUTPUT = os.environ.get("HF_MODEL_OUTPUT") # Ej: "tu-usuario/leandro-bot-lora"

# Cargar Llama 3.2 en 4-bit (optimizado para Colab gratis)
model, tokenizer = FastLanguageModel.from_pretrained(
    model_name = "unsloth/llama-3.2-3b-instruct-bnb-4bit",
    max_seq_length = 2048,
    load_in_4bit = True,
)

# Aplicar adaptadores QLoRA
model = FastLanguageModel.get_peft_model(
    model,
    r = 16,
    target_modules = ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    lora_alpha = 16,
    lora_dropout = 0,
    bias = "none",
)

# Cargar dataset de Hugging Face
dataset = load_dataset(HF_DATASET_REPO, data_files="dataset.jsonl", split="train")

trainer = SFTTrainer(
    model = model,
    tokenizer = tokenizer,
    train_dataset = dataset,
    dataset_text_field = "text",
    max_seq_length = 2048,
    dataset_num_proc = 2,
    packing = False,
    args = TrainingArguments(
        per_device_train_batch_size = 2,
        gradient_accumulation_steps = 4,
        warmup_steps = 5,
        max_steps = 60, # Ajustable según el tamaño de la conversación
        learning_rate = 2e-4,
        fp16 = True,
        logging_steps = 1,
        output_dir = "outputs",
    ),
)

trainer.train()

# Guardar y publicar el adaptador resultante a Hugging Face
model.push_to_hub_merged(HF_MODEL_OUTPUT, tokenizer, save_method = "lora", token = HF_TOKEN)
